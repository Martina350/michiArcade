generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  age       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ratings   Rating[]
}

model Game {
  id           String   @id @default(uuid())
  title        String
  description  String?
  ageRange     String
  embedUrl     String
  biome        String
  mapPositionX Float    @default(0)
  mapPositionY Float    @default(0)
  unlockOrder  Int      @default(0)
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ratings      Rating[]
}

model Rating {
  id        String   @id @default(uuid())
  stars     Int      // 1 to 5
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId]) // A user can only rate a game once (optional but good practice)
}
